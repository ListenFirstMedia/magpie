{
  "_comment": "Rename this file to .mcp.json to activate Playwright MCP for this project. Renaming triggers Claude Code's MCP-server approval prompt. See MIGRATION.md. Add --headless to args once storageState auth is validated. Jira fetch uses a separate, interactively-authenticated Atlassian MCP that may be absent in headless `claude -p` runs — pre-fetch test cases into testcases/english/ during an interactive session, or wire a remote Atlassian MCP server here.",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser", "chrome",
        "--storage-state", "./config/storageState.json",
        "--save-trace",
        "--output-dir", "./.playwright-out"
      ]
    }
  }
}
