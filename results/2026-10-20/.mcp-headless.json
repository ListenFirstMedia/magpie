{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest",
               "--browser", "chrome",
               "--isolated", "--headless", "--save-session",
               "--output-dir", "./.playwright-out",
               "--image-responses", "omit",
               "--console-level", "error"]
    }
  }
}
