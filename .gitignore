# macOS junk
.DS_Store
.AppleDouble
.LSOverride
._*

# Credentials — defensive: the current file has no secrets (Google SSO only),
# but keep it out of git so a future password addition doesn't leak.
# If you want a checked-in template, rename to credentials.example.md.
config/credentials.md

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache (from the ad-hoc _make_pdf*.py scripts)
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Temp / scratch
*.tmp
*.bak
*.orig

# Playwright MCP (feature/playwright-mcp track)
config/storageState.json
.playwright-out/
.playwright-profile/

# Login credentials for automated Cognito email/password sign-in
.env
config/.env

# OS / editor lock files
.~lock.*#

# Screenshots are test ARTIFACTS, not source — never commit them to git. Evidence is
# archived per-build by CI (Jenkins archiveArtifacts of results/**/*.png) and lives on disk
# beside its report under results/<date>/ or in the .playwright-out/ scratch dir.
*.png
# Stray root-level yml dumps from the Playwright MCP (bare filenames to CWD).
/*.yml
/*.yaml
